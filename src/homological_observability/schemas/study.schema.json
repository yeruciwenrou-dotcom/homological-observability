{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:homological-observability:schema:study:1",
  "title": "Homological observability configuration study",
  "description": "Authoring contract for valid studies. Runtime comparison additionally retains invalid candidate readouts as individual ERROR rows; graph and shared settings must always be valid. Graph connectivity, undirected-edge uniqueness and configuration identifier uniqueness are validated by the parser.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "model",
    "configurations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "name",
        "vertices",
        "edges"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "vertices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/configuration"
      }
    }
  },
  "$defs": {
    "edge": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "coefficient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge",
        "coefficient"
      ],
      "properties": {
        "edge": {
          "$ref": "#/$defs/edge"
        },
        "coefficient": {
          "type": "integer"
        }
      }
    },
    "readout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "coefficients"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "coefficients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coefficient"
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "observation_time": [
          "sampling_interval"
        ],
        "sampling_interval": [
          "observation_time"
        ]
      },
      "allOf": [
        {
          "not": {
            "required": [
              "alpha",
              "observation_time"
            ]
          }
        },
        {
          "not": {
            "required": [
              "alpha",
              "sampling_interval"
            ]
          }
        }
      ],
      "properties": {
        "max_layer": {
          "type": "integer",
          "minimum": 1
        },
        "max_cycles": {
          "type": "integer",
          "minimum": 1
        },
        "alpha": {
          "type": "number",
          "minimum": 0
        },
        "observation_time": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sampling_interval": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "readouts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "readouts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readout"
          }
        }
      }
    }
  }
}
