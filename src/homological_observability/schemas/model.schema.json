{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:homological-observability:schema:model:2",
  "title": "Homological observability graph model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "vertices", "edges"],
  "properties": {
    "schema_version": { "const": 2 },
    "name": { "type": "string", "minLength": 1 },
    "vertices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "edges": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/edge" }
    },
    "readouts": {
      "type": "array",
      "items": { "$ref": "#/$defs/readout" }
    },
    "analysis": { "$ref": "#/$defs/analysis" }
  },
  "$defs": {
    "edge": {
      "type": "array",
      "prefixItems": [
        { "type": "string", "minLength": 1 },
        { "type": "string", "minLength": 1 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "coefficient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge", "coefficient"],
      "properties": {
        "edge": { "$ref": "#/$defs/edge" },
        "coefficient": { "type": "integer" }
      }
    },
    "readout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "coefficients"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "coefficients": {
          "type": "array",
          "items": { "$ref": "#/$defs/coefficient" }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "observation_time": ["sampling_interval"],
        "sampling_interval": ["observation_time"]
      },
      "allOf": [
        {
          "not": {
            "required": ["alpha", "observation_time"]
          }
        },
        {
          "not": {
            "required": ["alpha", "sampling_interval"]
          }
        }
      ],
      "properties": {
        "max_layer": { "type": "integer", "minimum": 1 },
        "max_cycles": { "type": "integer", "minimum": 1 },
        "alpha": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "string", "pattern": "^[0-9]+/[0-9]*[1-9][0-9]*$", "maxLength": 8601}]},
        "observation_time": { "type": "number", "exclusiveMinimum": 0 },
        "sampling_interval": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
