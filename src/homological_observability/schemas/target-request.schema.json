{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:homological-observability:schema:target-request:1",
  "title": "Target task request v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "enum": [
        "analyze",
        "design",
        "evaluate"
      ]
    },
    "model": {
      "title": "Homological observability graph model",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "name",
        "vertices",
        "edges"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            1,
            2
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "vertices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "readouts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readout"
          }
        },
        "analysis": {
          "$ref": "#/$defs/analysis"
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/readout"
      },
      "minItems": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/readout"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_subsets": {
          "type": "integer",
          "minimum": 1
        },
        "max_solutions": {
          "type": "integer",
          "minimum": 1
        },
        "max_matrix_entries": {
          "type": "integer",
          "minimum": 1
        },
        "max_integer_bits": {
          "type": "integer",
          "minimum": 1
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_explanation_cycles": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": []
    },
    "reverse_tree_order": {
      "type": "boolean"
    },
    "record": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "raw",
                "cycle"
              ]
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "start": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "raw"
                  }
                }
              },
              "then": {
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "string",
                    "minLength": 1
                  },
                  "end": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "start": {
                    "const": null
                  },
                  "end": {
                    "const": null
                  }
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "explain": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "operation",
    "model",
    "targets"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "evaluate"
          }
        }
      },
      "then": {
        "required": [
          "record"
        ],
        "properties": {
          "record": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "raw",
                  "cycle"
                ]
              },
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "start": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "end": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind",
              "values"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "raw"
                    }
                  }
                },
                "then": {
                  "required": [
                    "start",
                    "end"
                  ],
                  "properties": {
                    "start": {
                      "type": "string",
                      "minLength": 1
                    },
                    "end": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "else": {
                  "properties": {
                    "start": {
                      "const": null
                    },
                    "end": {
                      "const": null
                    }
                  }
                }
              }
            ]
          },
          "explain": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "record": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "analyze",
              "evaluate"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "candidates": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "edge": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "coefficient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge",
        "coefficient"
      ],
      "properties": {
        "edge": {
          "$ref": "#/$defs/edge"
        },
        "coefficient": {
          "type": "integer"
        }
      }
    },
    "readout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "coefficients"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "coefficients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coefficient"
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "observation_time": [
          "sampling_interval"
        ],
        "sampling_interval": [
          "observation_time"
        ]
      },
      "allOf": [
        {
          "not": {
            "required": [
              "alpha",
              "observation_time"
            ]
          }
        },
        {
          "not": {
            "required": [
              "alpha",
              "sampling_interval"
            ]
          }
        }
      ],
      "properties": {
        "max_layer": {
          "type": "integer",
          "minimum": 1
        },
        "max_cycles": {
          "type": "integer",
          "minimum": 1
        },
        "alpha": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+/[0-9]*[1-9][0-9]*$",
              "maxLength": 8601
            }
          ]
        },
        "observation_time": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sampling_interval": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
