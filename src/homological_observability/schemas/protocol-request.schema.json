{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:homological-observability:schema:protocol-request:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "target": {
      "$ref": "#/$defs/readout"
    },
    "time_unit": {
      "type": "string",
      "minLength": 1
    },
    "target_unit": {
      "type": "string",
      "minLength": 1
    },
    "rates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rate"
      }
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "reverse_tree_order": {
      "type": "boolean"
    },
    "horizon": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "snapshots": {
            "type": "integer",
            "minimum": 2
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "snapshots",
          "channels"
        ]
      },
      "minItems": 2,
      "maxItems": 64
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "events"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "trajectories": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "trajectory_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "times": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 1
                  },
                  "states": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "trajectory_id",
                  "times",
                  "states"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "name",
            "trajectories"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "simulate"
            },
            "trajectories": {
              "type": "integer",
              "minimum": 1
            },
            "initial_distribution": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "max_events_per_path": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "trajectories",
            "initial_distribution",
            "seed"
          ]
        }
      ]
    },
    "risk_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "schema_version",
    "model",
    "target",
    "time_unit",
    "horizon",
    "protocols",
    "source"
  ],
  "$defs": {
    "edge": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "coefficient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge",
        "coefficient"
      ],
      "properties": {
        "edge": {
          "$ref": "#/$defs/edge"
        },
        "coefficient": {
          "type": "integer"
        }
      }
    },
    "readout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "coefficients"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "coefficients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coefficient"
          }
        }
      }
    },
    "model": {
      "title": "Homological observability graph model",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "name",
        "vertices",
        "edges"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            1,
            2
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "vertices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "readouts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readout"
          }
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        }
      }
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "rate": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "from",
        "to",
        "rate"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "max_grid_points": {
          "type": "integer",
          "minimum": 1
        },
        "max_matrix_entries": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": []
    }
  }
}
